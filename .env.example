# Copy to .env (repo root) and fill in. Never commit .env.

# Gnani (Prisma STT, Timbre TTS). See docs/gnani-api.md
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE_CODE=hi-IN,en-IN
GNANI_STT_FORMAT=codemix
# Fallback keyterms, JSON array (max 200), e.g. ["MS sheet","bracket","kg"]. Per-client terms come from the DB
GNANI_STT_KEYTERMS=[]
GNANI_STT_TIMEOUT=60
# Max seconds per VAD chunk sent to Prisma REST (hard limit 30). Lower = finer proof clips
GNANI_STT_MAX_CHUNK_S=28
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Poorvi
# Timbre language, hi-en = Hinglish
GNANI_TTS_LANGUAGE=hi-en

# WhatsApp Cloud API (Meta test number)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Any random string, same value in the Meta app dashboard
WA_VERIFY_TOKEN=
# Meta app secret, for X-Hub-Signature-256 checks
WA_APP_SECRET=
WA_GRAPH_API_VERSION=v21.0
# Hard cap on outbound messages per day
WA_DAILY_SEND_CAP=50
# Owner's number (country code, no +), gets confirmations and the briefing
OWNER_WA_NUMBER=

# LLMs: Groq primary, Gemini Flash-Lite fallback
GROQ_API_KEY=
# e.g. openai/gpt-oss-120b. Required: a provider without a model is skipped
GROQ_MODEL=
GEMINI_API_KEY=
# e.g. gemini-3.5-flash-lite
GEMINI_MODEL=

# Bearer token for POST /briefing/send, /briefing/preview and /pending/{id}/resolve. Any random string
CRON_SECRET=
# Browser origins allowed to call the API, JSON list
CORS_ORIGINS=["http://localhost:3000"]

# Supabase. Service key is server side only (backend and dashboard server code)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_AUDIO_BUCKET=audio
