# Copy to dashboard/.env.local (or set in Vercel project settings). Never commit .env.local.
# Read only by server components. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Private storage bucket holding voice notes and proof clips
SUPABASE_AUDIO_BUCKET=audio
# FastAPI backend, used by the Pending buttons and the morning briefing preview (server actions)
BACKEND_URL=http://localhost:8000
# Same value as CRON_SECRET in the backend .env, sent as a Bearer token
CRON_SECRET=
